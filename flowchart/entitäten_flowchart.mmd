%% =============================================================================
%%  Skytech Energy Pilot – HEMS ↔ EP Datenfluss (nur HEMS-relevant)
%% =============================================================================
%%  ZWECK
%%    Ausschnitt auf genau die Daten/Werte, die die HEMS↔EP-Schnittstelle
%%    betreffen. Drei Gruppen:
%%      1) ems_* HA-(Helfer-)Entitäten  – HEMS besitzt, EP liest (HEMS → EP)
%%      2) ep_*_vorschlag               – EP erzeugt, schreibt nach HA (EP → HA)
%%      3) REST-API-Endpunkte           – EP ↔ HEMS direkt (Schema/Status; set M3+)
%%    Bewusst NICHT im Bild: Haus-Messgrößen, PV-Prognose, Wetter/zone,
%%    Cloud-KI, Zusatz-Entitäten (advisorisch, gehen NICHT ans HEMS), EP-Status.

%%  RENDERN
%%    - VS Code: Extension "Mermaid Editor" (Datei direkt öffnen, kein Fence nötig)
%%    - CLI:     npx @mermaid-js/mermaid-cli -i entitäten_flowchart.mmd -o entitaeten_flowchart.png
%%    - Online:  https://mermaid.live  (Dateiinhalt einfügen)

%%  KONVENTIONEN
%%    - „liest“   = EP liest aus HA-Helfer / HEMS-API
%%    - „schreibt“= EP schreibt Vorschlagswert nach HA
%%    - NEUES GERÄT: eigenen ems_*-Block (LEG_EMS_*) + ep_*_vorschlag ergänzen,
%%      Hauptchart-Sammelboxen bleiben unverändert.
%% =============================================================================

flowchart TB

%% ###########################################################################
%% ##  1) HAUPTCHART · nur HEMS↔EP-Kernflüsse
%% ###########################################################################

subgraph SYSTEM[" "]
direction TB

subgraph HA["🏠 Home Assistant · HA-(Helfer-)Entitäten"]
  direction TB
  ha_ems["⚙️ ems_* Gerätewerte\n4 Geräte · HEMS-Domäne · EP liest"]
  ha_epw["📤 ep_*_vorschlag\nEP-Vorschlagswerte · EP schreibt"]
end

subgraph HEMS["⚙️ HEMS-Addon · Echtzeitregelung (1–2s)"]
  direction TB
  hems_core["Regler\nbesitzt + regelt ems_*"]
  hems_api["REST-API\nsiehe Legende LEG_API"]
end

subgraph EP["🧭 Energy Pilot · Planung (plant, regelt nie)"]
  direction TB
  ep_read["Collectors\nDeviceCollector + HEMSStatusCollector"]
  ep_make["Planner + Validator\nerzeugt Vorschlagswerte"]
  ep_pub["Publisher\nschreibt ep_*_vorschlag"]
  ep_client["HEMSClient / HAClient\nTransport"]
end

%% -- 1) ems_* HA-Helfer: HEMS besitzt → EP liest --
hems_core -->|besitzt/regelt| ha_ems
ha_ems -->|liest| ep_read

%% -- 3) HEMS-API direkt: EP liest Schema/Status --
hems_api -->|Schema/Status/Controls| ep_read

%% -- EP erzeugt Vorschlagswerte --
ep_read --> ep_make --> ep_pub

%% -- 2) ep_*_vorschlag: EP schreibt nach HA --
ep_pub -->|schreibt| ha_epw

%% -- 3) künftig: EP schreibt Vorschlag per API direkt ans HEMS --
ep_client -. künftig POST /api/set (M3+) .-> hems_api
ep_client -. Transport .- ep_read
ep_client -. Transport .- ep_pub

end

%% ###########################################################################
%% ##  2) LEGENDE · Einzel-Entitäten / Helfer / API-Endpunkte je Gruppe
%% ###########################################################################

subgraph LEGENDE["📖 Legende · Einzel-Entitäten / Helfer / API-Endpunkte je Gruppe"]
  direction TB

  subgraph LEG_ROW1[" "]
  direction LR

  subgraph LEG_HA_EMS["→ ha_ems: ems_* je Gerät (HEMS-Domäne, EP liest)"]
    direction TB
    subgraph LEG_EMS_BAT["Batterie · immer Prio1/freigegeben"]
      direction TB
      eb_f["ems_batterie_technische_freigabe"]
      eb_min["ems_batterie_min_technisch_w"]
      eb_max["ems_batterie_max_technisch_w"]
    end
    subgraph LEG_EMS_HS["Heizstab · regelbar"]
      direction TB
      eh_f["ems_heizstab_technische_freigabe"]
      eh_min["ems_heizstab_min_technisch_w"]
      eh_max["ems_heizstab_max_technisch_w"]
    end
    subgraph LEG_EMS_HL1["Heizlüfter 1 · binär 1500W"]
      direction TB
      el1_f["ems_heizluefter_1_technische_freigabe"]
      el1_p["ems_heizluefter_1_leistung_w"]
    end
    subgraph LEG_EMS_HL2["Heizlüfter 2 · binär 1500W"]
      direction TB
      el2_f["ems_heizluefter_2_technische_freigabe"]
      el2_p["ems_heizluefter_2_leistung_w"]
    end
    ems_future[/"weitere Geräte analog: ems_GERÄT_… (w bzw. a)"/]
  end

  end

  subgraph LEG_ROW2[" "]
  direction LR

  subgraph LEG_HA_EPW["→ ha_epw: ep_*_vorschlag (EP erzeugt + schreibt nach HA)"]
    direction TB
    w_prio["ep_GERÄT_prio_vorschlag · binär/regelbar"]
    w_frei["ep_GERÄT_freigabe_vorschlag · binär/regelbar"]
    w_minw["ep_GERÄT_geschutzte_mindestleistung_w_vorschlag"]
    w_mina["ep_GERÄT_geschutzte_mindestleistung_a_vorschlag · Ampere-Geräte"]
    w_bat["ep_batterie_geschutzte_mindestleistung_w_vorschlag · D-037"]
  end

  subgraph LEG_API["→ hems_api / ep_client: API-Endpunkte (EP ↔ HEMS)"]
    direction TB
    api_schema["GET /api/device_controls_schema · ems_* Entity-IDs"]
    api_status["GET /api/status · Plan-Rückkopplung"]
    api_controls["GET /api/controls"]
    api_set["POST /api/set · Vorschlag → HEMS (künftig M3+)"]
  end

  end

  LEG_ROW1 ~~~ LEG_ROW2
end

%% Reihenfolge erzwingen: Hauptchart oben, Legende darunter
SYSTEM ~~~ LEGENDE

%% ###########################################################################
%% ##  3) STYLING · Farbe = Gruppentyp
%% ###########################################################################
classDef ems     fill:#ffe8cc,stroke:#f59e0b,color:#5a3200;
classDef write   fill:#d7f5dd,stroke:#22c55e,color:#0a3d1a;
classDef comp    fill:#e9defb,stroke:#8b5cf6,color:#2b0f57;
classDef invisible fill:none,stroke:none;

class LEG_ROW1,LEG_ROW2,SYSTEM invisible;

%% Hauptchart
class ha_ems ems;
class ha_epw write;
class hems_core,hems_api,ep_read,ep_make,ep_pub,ep_client comp;

%% Legende (gleiche Farben wie zugehörige Hauptchart-Box)
class eb_f,eb_min,eb_max,eh_f,eh_min,eh_max,el1_f,el1_p,el2_f,el2_p,ems_future ems;
class w_prio,w_frei,w_minw,w_mina,w_bat write;
class api_schema,api_status,api_controls,api_set comp;
